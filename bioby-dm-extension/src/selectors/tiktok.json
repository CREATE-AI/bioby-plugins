{
  "profileMessageButton": [
    "button[data-e2e=\"message-button\"]",
    "a[data-e2e=\"message-button\"]",
    "button[aria-label*=\"Message\"]",
    "button[aria-label*=\"消息\"]"
  ],
  "composerTextarea": [
    "div.public-DraftEditor-content[contenteditable=\"true\"]",
    "div[contenteditable=\"true\"][role=\"textbox\"]",
    "div[data-e2e=\"message-input-area\"] div[contenteditable=\"true\"]",
    "textarea[placeholder*=\"Message\"]",
    "textarea[placeholder*=\"消息\"]"
  ],
  "sendButton": [
    "button[data-e2e=\"message-send\"]:not([disabled])",
    "button[data-e2e=\"message-send-btn\"]:not([disabled])",
    "button[aria-label=\"Send\"]:not([disabled])",
    "button[aria-label=\"发送\"]:not([disabled])",
    "button[aria-label*=\"发送\"]:not([disabled])"
  ],
  "loggedInHandleHints": [
    "a[data-e2e=\"nav-profile\"]",
    "a[data-e2e=\"profile-icon\"]",
    "div[data-e2e=\"profile-icon\"] a",
    "a[href*=\"/@\"][data-e2e*=\"profile\"]",
    "header a[href*=\"/@\"]",
    "[data-e2e=\"main-header\"] a[href*=\"/@\"]"
  ]
}
