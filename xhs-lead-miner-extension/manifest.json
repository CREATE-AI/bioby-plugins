{
  "manifest_version": 3,
  "name": "小红书线索挖掘助手",
  "version": "1.12.31",
  "description": "筛出可私信线索：导出小红书号 + HTML 预览触达",
  "permissions": ["storage", "tabs", "scripting", "alarms", "windows", "sidePanel", "debugger"],
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://edith.xiaohongshu.com/*",
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "https://api.moonshot.cn/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "小红书线索挖掘"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.xiaohongshu.com/*"],
      "js": ["content/time-parse.js", "content/state-bridge.js", "content/filter-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.xiaohongshu.com/*"],
      "js": [
        "content/inject-main.js",
        "content/status-banner.js",
        "content/time-parse.js",
        "content/extractor.js",
        "content/lead-filter.js",
        "content/search-filter.js",
        "content/content.js",
        "content/collect-helper.js",
        "content/note-detail.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/state-bridge.js",
        "content/filter-main.js"
      ],
      "matches": ["https://www.xiaohongshu.com/*"]
    }
  ]
}
